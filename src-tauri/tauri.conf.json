{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Økta",
  "version": "0.3.0",
  "identifier": "no.elevtracking.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Økta",
        "width": 1280,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 640,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "okta"
        ],
        "name": "Oppsettfil for Økta",
        "description": "Oppsettfil for Økta",
        "role": "Viewer",
        "rank": "Owner",
        "contentTypes": [
          "no.elevtracking.oppsett"
        ],
        "exportedType": {
          "identifier": "no.elevtracking.oppsett",
          "conformsTo": [
            "public.json",
            "public.data"
          ]
        }
      }
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "13.0"
    }
  }
}
